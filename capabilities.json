{
    "dataRoles": [
        {
            "displayName": "Values (numeric)",
            "displayNameKey": "Role_Values_DisplayName",
            "name": "values",
            "kind": "Grouping",
            "description": "Drag a numeric column here. For repeated values, also add the same column to Frequency as Count.",
            "descriptionKey": "Role_Values_Description"
        },
        {
            "displayName": "Frequency (Count)",
            "displayNameKey": "Role_Frequency_DisplayName",
            "name": "frequency",
            "kind": "Measure",
            "description": "Optional. Use Count of the Values column when repeated values should be counted. Leave empty for continuous data.",
            "descriptionKey": "Role_Frequency_Description"
        }
    ],
    "objects": {
        "bins": {
            "properties": {
                "mode": {
                    "type": { "enumeration": [
                        { "value": "auto",  "displayName": "Auto (Sturges)" },
                        { "value": "count", "displayName": "Number of bins" },
                        { "value": "width", "displayName": "Bin width" }
                    ]}
                },
                "count": { "type": { "numeric": true } },
                "width":  { "type": { "numeric": true } }
            }
        },
        "bars": {
            "properties": {
                "fill":        { "type": { "fill": { "solid": { "color": true } } } },
                "fillOpacity": { "type": { "numeric": true } },
                "stroke":      { "type": { "fill": { "solid": { "color": true } } } },
                "gap":         { "type": { "numeric": true } }
            }
        },
        "normalCurve": {
            "properties": {
                "show":        { "type": { "bool": true } },
                "color":       { "type": { "fill": { "solid": { "color": true } } } },
                "strokeWidth": { "type": { "numeric": true } }
            }
        },
        "specLimits": {
            "properties": {
                "show":    { "type": { "bool": true } },
                "lsl":     { "type": { "numeric": true } },
                "usl":     { "type": { "numeric": true } },
                "color":   { "type": { "fill": { "solid": { "color": true } } } },
                "showLabels": { "type": { "bool": true } },
                "showTarget": { "type": { "bool": true } },
                "target":  { "type": { "numeric": true } },
                "showCpk": { "type": { "bool": true } },
                "decimals": { "type": { "numeric": true } }
            }
        },
        "referenceLines": {
            "properties": {
                "showMean":   { "type": { "bool": true } },
                "showMedian": { "type": { "bool": true } },
                "showSd":     { "type": { "bool": true } },
                "sdCount":    { "type": { "numeric": true } },
                "color":      { "type": { "fill": { "solid": { "color": true } } } },
                "strokeWidth": { "type": { "numeric": true } }
            }
        },
        "xAxis": {
            "properties": {
                "show":       { "type": { "bool": true } },
                "customRange": { "type": { "bool": true } },
                "min":        { "type": { "numeric": true } },
                "max":        { "type": { "numeric": true } },
                "title":      { "type": { "text": true } },
                "numberFormat": { "type": { "text": true } },
                "labelColor": { "type": { "fill": { "solid": { "color": true } } } },
                "fontSize":   { "type": { "formatting": { "fontSize": true } } }
            }
        },
        "yAxis": {
            "properties": {
                "show":       { "type": { "bool": true } },
                "title":      { "type": { "text": true } },
                "numberFormat": { "type": { "text": true } },
                "labelColor": { "type": { "fill": { "solid": { "color": true } } } },
                "fontSize":   { "type": { "formatting": { "fontSize": true } } }
            }
        }
    },
    "dataViewMappings": [
        {
            "conditions": [
                { "values": { "min": 1, "max": 1 }, "frequency": { "min": 0, "max": 1 } }
            ],
            "categorical": {
                "categories": {
                    "bind": { "to": "values" },
                    "dataReductionAlgorithm": {
                        "window": { "count": 30000 }
                    }
                },
                "values": {
                    "for": { "in": "frequency" }
                }
            }
        }
    ],
    "tooltips": {
        "supportedTypes": {
            "default": true,
            "canvas": true
        },
        "roles": ["values", "frequency"],
        "supportEnhancedTooltips": true
    },
    "supportsKeyboardFocus": true,
    "supportsHighlight": true,
    "supportsMultiVisualSelection": true,
    "supportsLandingPage": true,
    "supportsEmptyDataView": true,
    "privileges": []
}
