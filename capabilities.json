{
    "dataRoles": [
        {
            "displayName": "Values",
            "name": "values",
            "kind": "Grouping",
            "description": "Numeric column to build the histogram from. Power BI returns distinct values; for data with repeats add the same column to Frequency as a Count."
        },
        {
            "displayName": "Frequency",
            "name": "frequency",
            "kind": "Measure",
            "description": "Optional. Count (or weight) per value. Drag your value column here set to Count to histogram data with repeated values. Leave empty for continuous data."
        }
    ],
    "objects": {
        "bins": {
            "properties": {
                "mode": {
                    "type": { "enumeration": [
                        { "value": "auto",  "displayName": "Auto (Sturges)" },
                        { "value": "count", "displayName": "Number of bins" },
                        { "value": "width", "displayName": "Bin width" }
                    ]}
                },
                "count": { "type": { "numeric": true } },
                "width":  { "type": { "numeric": true } }
            }
        },
        "bars": {
            "properties": {
                "fill":        { "type": { "fill": { "solid": { "color": true } } } },
                "fillOpacity": { "type": { "numeric": true } },
                "stroke":      { "type": { "fill": { "solid": { "color": true } } } }
            }
        },
        "normalCurve": {
            "properties": {
                "show":        { "type": { "bool": true } },
                "color":       { "type": { "fill": { "solid": { "color": true } } } },
                "strokeWidth": { "type": { "numeric": true } }
            }
        },
        "specLimits": {
            "properties": {
                "show":    { "type": { "bool": true } },
                "lsl":     { "type": { "numeric": true } },
                "usl":     { "type": { "numeric": true } },
                "color":   { "type": { "fill": { "solid": { "color": true } } } },
                "showCpk": { "type": { "bool": true } }
            }
        },
        "xAxis": {
            "properties": {
                "show":       { "type": { "bool": true } },
                "labelColor": { "type": { "fill": { "solid": { "color": true } } } },
                "fontSize":   { "type": { "formatting": { "fontSize": true } } }
            }
        },
        "yAxis": {
            "properties": {
                "show":       { "type": { "bool": true } },
                "labelColor": { "type": { "fill": { "solid": { "color": true } } } },
                "fontSize":   { "type": { "formatting": { "fontSize": true } } }
            }
        }
    },
    "dataViewMappings": [
        {
            "conditions": [
                { "values": { "min": 1, "max": 1 }, "frequency": { "min": 0, "max": 1 } }
            ],
            "categorical": {
                "categories": {
                    "bind": { "to": "values" },
                    "dataReductionAlgorithm": {
                        "window": { "count": 30000 }
                    }
                },
                "values": {
                    "for": { "in": "frequency" }
                }
            }
        }
    ],
    "privileges": []
}
